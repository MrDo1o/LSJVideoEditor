<Application
    x:Class="LSJVideoElite.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Bauhaus Dark-Mode Sovereign Color Palette -->
            <Color x:Key="LSJBackground">#070a12</Color>
            <Color x:Key="LSJCardBackground">#0d1321</Color>
            <Color x:Key="LSJCardBackgroundDark">#0a101c</Color>
            <Color x:Key="LSJCyan">#66e0e0</Color>
            <Color x:Key="LSJCyanHover">#4cc8c8</Color>
            <Color x:Key="LSJText">#eef3f8</Color>
            <Color x:Key="LSJMuted">#8b93a7</Color>
            <Color x:Key="LSJAlert">#c44545</Color>
            <Color x:Key="LSJBorder">#1a2233</Color>

            <SolidColorBrush x:Key="LSJBackgroundBrush" Color="{StaticResource LSJBackground}" />
            <SolidColorBrush x:Key="LSJCardBrush" Color="{StaticResource LSJCardBackground}" />
            <SolidColorBrush x:Key="LSJCardDarkBrush" Color="{StaticResource LSJCardBackgroundDark}" />
            <SolidColorBrush x:Key="LSJCyanBrush" Color="{StaticResource LSJCyan}" />
            <SolidColorBrush x:Key="LSJCyanHoverBrush" Color="{StaticResource LSJCyanHover}" />
            <SolidColorBrush x:Key="LSJTextBrush" Color="{StaticResource LSJText}" />
            <SolidColorBrush x:Key="LSJMutedBrush" Color="{StaticResource LSJMuted}" />
            <SolidColorBrush x:Key="LSJBorderBrush" Color="{StaticResource LSJBorder}" />

            <Style TargetType="Button" x:Key="LSJCyanButtonStyle">
                <Setter Property="Background" Value="{StaticResource LSJCyanBrush}"/>
                <Setter Property="Foreground" Value="#041016"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="12,6"/>
            </Style>

            <Style TargetType="Button" x:Key="LSJCardButtonStyle">
                <Setter Property="Background" Value="{StaticResource LSJCardDarkBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource LSJTextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource LSJBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="10,6"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

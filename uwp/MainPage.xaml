<Page
    x:Class="LSJVideoElite.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource LSJBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER TOOLBAR -->
        <Border Grid.Row="0" Background="{StaticResource LSJCardBrush}" BorderBrush="{StaticResource LSJBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LSJ Video Elite" FontSize="14" FontWeight="Bold" Foreground="{StaticResource LSJTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="#163047" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="SSK SOVEREIGN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource LSJCyanBrush}" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="ProjectTitleText" Text="Untitled Project" FontSize="12" Foreground="{StaticResource LSJMutedBrush}" VerticalAlignment="Center" Margin="16,0" />

                <!-- Natural Language SSK Copilot Input Bar -->
                <Grid Grid.Column="2" Margin="16,8">
                    <TextBox x:Name="SSKPromptInput" PlaceholderText="Ask SSK to edit, veto entity, reverse search frame, auto-cut, or mashup..." 
                             Background="{StaticResource LSJCardDarkBrush}" Foreground="{StaticResource LSJTextBrush}"
                             BorderBrush="{StaticResource LSJBorderBrush}" BorderThickness="1" CornerRadius="4"
                             KeyDown="OnSSKPromptKeyDown" VerticalAlignment="Center" Padding="10,6" />
                </Grid>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <Button Content="SSK Veto" Style="{StaticResource LSJCyanButtonStyle}" Click="OnSSKVetoClick" />
                    <Button Content="4-1 Visual" Style="{StaticResource LSJCyanButtonStyle}" Click="OnVisualSearchClick" />
                    <Button Content="Director" Style="{StaticResource LSJCardButtonStyle}" Click="OnDirectorModeClick" />
                    <Button Content="Export MP4" Style="{StaticResource LSJCyanButtonStyle}" Click="OnExportClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN 3-COLUMN WORKSPACE -->
        <Grid Grid.Row="1" Margin="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <!-- 2A. LEFT: MEDIA BIN -->
            <Border Grid.Column="0" Background="{StaticResource LSJCardBrush}" BorderBrush="{StaticResource LSJBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="10,0" Background="{StaticResource LSJCardDarkBrush}">
                        <TextBlock Text="Media Bin" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource LSJTextBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                            <Button Content="+" Style="{StaticResource LSJCardButtonStyle}" Width="32" Click="OnImportMediaClick" />
                            <Button Content="Folder" Style="{StaticResource LSJCardButtonStyle}" Click="OnImportFolderClick" />
                        </StackPanel>
                    </Grid>

                    <ListView Grid.Row="1" x:Name="MediaBinList" SelectionChanged="OnMediaSelectionChanged" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="26" Background="#060c14" CornerRadius="3" Margin="0,0,8,0">
                                        <TextBlock Text="VID" FontSize="9" FontWeight="Bold" Foreground="{StaticResource LSJCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource LSJTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DurationStr}" FontSize="10" Foreground="{StaticResource LSJMutedBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 2B. CENTER: HARDWARE DIRECT3D SWAPCHAIN PLAYER -->
            <Border Grid.Column="1" Background="{StaticResource LSJCardBrush}" BorderBrush="{StaticResource LSJBorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="48" />
                    </Grid.RowDefinitions>

                    <!-- Direct3D11 / DirectX 12 Viewport -->
                    <SwapChainPanel Grid.Row="0" x:Name="VideoViewport" Background="#04060a" />

                    <!-- Transport Controls -->
                    <Border Grid.Row="1" Background="{StaticResource LSJCardDarkBrush}" Padding="10,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" x:Name="CurrentTimeText" Text="0:00.00" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource LSJMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="-5s" Style="{StaticResource LSJCardButtonStyle}" Width="36" Click="OnJumpBackClick" />
                                <Button x:Name="PlayPauseButton" Content="Play" Style="{StaticResource LSJCyanButtonStyle}" Width="56" Click="OnPlayPauseClick" />
                                <Button Content="+5s" Style="{StaticResource LSJCardButtonStyle}" Width="36" Click="OnJumpForwardClick" />
                            </StackPanel>

                            <Slider Grid.Column="2" x:Name="TimeScrubber" Minimum="0" Maximum="1000" Value="0" ValueChanged="OnScrubberChanged" Margin="16,0" VerticalAlignment="Center" />

                            <TextBlock Grid.Column="3" x:Name="TotalTimeText" Text="0:00.00" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource LSJMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 2C. RIGHT: INSPECTOR & PERMANENTLY EXTENDED SSK THOUGHT PROCESS CONSOLE -->
            <Border Grid.Column="2" Background="{StaticResource LSJCardBrush}" BorderBrush="{StaticResource LSJBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Clip Inspector Info -->
                    <Border Grid.Row="0" Background="{StaticResource LSJCardDarkBrush}" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Inspector / Selected Asset" FontSize="11" FontWeight="Bold" Foreground="{StaticResource LSJTextBrush}" Margin="0,0,0,4" />
                            <TextBlock x:Name="InspectorInfoText" Text="Select a clip in the bin or timeline." FontSize="10" FontFamily="Consolas" Foreground="{StaticResource LSJMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- SSK Thought Process Console Header & Controls -->
                    <Border Grid.Row="1" Background="#060c14" Padding="10,6" BorderBrush="{StaticResource LSJBorderBrush}" BorderThickness="0,1,0,1">
                        <Grid>
                            <TextBlock Text="SSK SOVEREIGN VISION &amp; VETO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource LSJCyanBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                <Button x:Name="ExpandThoughtButton" Content="⛶ Expand" Style="{StaticResource LSJCardButtonStyle}" Click="OnToggleThoughtExpand" Padding="6,2" FontSize="10" />
                                <Button Content="🗗 Pop-out" Style="{StaticResource LSJCardButtonStyle}" Click="OnPopoutThoughtClick" Padding="6,2" FontSize="10" />
                                <Button Content="✕ Clear" Style="{StaticResource LSJCardButtonStyle}" Click="OnClearThoughtClick" Padding="6,2" FontSize="10" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Thought Process Body & Models Container -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ThoughtRowDef" Height="190" />
                            <RowDefinition x:Name="ModelsRowDef" Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Dedicated, Non-Collapsing Thought Box with Monospace Stream -->
                        <ScrollViewer Grid.Row="0" x:Name="ThoughtScrollViewer" Background="{StaticResource LSJCardDarkBrush}" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="SSKThoughtProcessBox" 
                                     Text="SSK Engine Ready. Veto gate, 4-1 visual search, and autonomous director actions online."
                                     FontFamily="Consolas" FontSize="10" Foreground="{StaticResource LSJCyanBrush}"
                                     Background="Transparent" BorderThickness="0" TextWrapping="Wrap"
                                     IsReadOnly="True" AcceptsReturn="True" Padding="8" />
                        </ScrollViewer>

                        <!-- Collapsible Models & Parameter Controls -->
                        <Grid Grid.Row="1" x:Name="ModelsContainer" Background="{StaticResource LSJCardBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Padding="10,6">
                                <TextBlock Text="ELITE MODELS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource LSJMutedBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="CategoryCombo" HorizontalAlignment="Right" Width="140" SelectionChanged="OnCategoryChanged" />
                            </Grid>

                            <ListView Grid.Row="1" x:Name="ModelListView" SelectionChanged="OnModelSelectionChanged" Background="{StaticResource LSJCardDarkBrush}" Margin="8,0" />

                            <Grid Grid.Row="2" Padding="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Content="AutoShot" Style="{StaticResource LSJCardButtonStyle}" HorizontalAlignment="Stretch" Margin="2" Click="OnAutoShotClick" />
                                <Button Grid.Row="0" Grid.Column="1" Content="Beat Sync" Style="{StaticResource LSJCardButtonStyle}" HorizontalAlignment="Stretch" Margin="2" Click="OnBeatSyncClick" />
                                <Button Grid.Row="1" Grid.Column="0" Content="Upscale 2x" Style="{StaticResource LSJCardButtonStyle}" HorizontalAlignment="Stretch" Margin="2" Click="OnUpscaleClick" />
                                <Button Grid.Row="1" Grid.Column="1" Content="Stabilize" Style="{StaticResource LSJCardButtonStyle}" HorizontalAlignment="Stretch" Margin="2" Click="OnStabilizeClick" />
                                <Button Grid.Row="2" Grid.Column="0" Content="Captions" Style="{StaticResource LSJCardButtonStyle}" HorizontalAlignment="Stretch" Margin="2" Click="OnCaptionsClick" />
                                <Button Grid.Row="2" Grid.Column="1" Content="HDR Master" Style="{StaticResource LSJCardButtonStyle}" HorizontalAlignment="Stretch" Margin="2" Click="OnHDRMasterClick" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. BOTTOM: MULTI-TRACK TIMELINE -->
        <Border Grid.Row="2" Background="{StaticResource LSJCardBrush}" BorderBrush="{StaticResource LSJBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Filter:" FontSize="11" Foreground="{StaticResource LSJMutedBrush}" VerticalAlignment="Center" />
                        <ComboBox x:Name="FilterCombo" Width="160" SelectionChanged="OnFilterChanged" />
                        <Button Content="Split (B)" Style="{StaticResource LSJCardButtonStyle}" Click="OnSplitPlayheadClick" />
                        <Button Content="Ripple Del" Style="{StaticResource LSJCardButtonStyle}" Click="OnRippleDeleteClick" />
                    </StackPanel>
                    <Button Content="Add All to Timeline" Style="{StaticResource LSJCyanButtonStyle}" HorizontalAlignment="Right" Click="OnAddAllClick" />
                </Grid>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Canvas x:Name="TimelineCanvas" Width="2400" Height="170" Background="{StaticResource LSJCardDarkBrush}" PointerPressed="OnTimelinePointerPressed" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 4. FOOTER STATUS BAR -->
        <Border Grid.Row="3" Background="#060c14" BorderBrush="{StaticResource LSJBorderBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="StatusMessageText" Text="Ready · SSK Sovereign Engine (Protocol IOPQ-08 Locked Baseline)" FontSize="10" Foreground="{StaticResource LSJMutedBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="HardwareStatusText" Text="Hardware Direct3D12 · FFmpeg C Core · 71 Elite Models" FontSize="10" Foreground="{StaticResource LSJCyanBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>
